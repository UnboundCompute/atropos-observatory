{
  "name": "atropos-observatory",
  "version": "0.1.0",
  "description": "A searchable, human-readable security reference for Atropos model semantics.",
  "keywords": ["security", "static-analysis", "taint-analysis", "vulnerability-research", "api-security", "atropos", "observatory"],
  "homepage": "https://atropos.unboundcompute.com",
  "repository": { "type": "git", "url": "https://github.com/UnboundCompute/atropos-observatory.git" },
  "bugs": { "url": "https://github.com/UnboundCompute/atropos-observatory/issues" },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "prepare:data": "node scripts/build-catalog.mjs",
    "check:catalog": "node scripts/validate-catalog.mjs",
    "check:content": "node scripts/validate-editorial.mjs",
    "check:output": "node scripts/validate-output.mjs",
    "build": "npm run prepare:data && npm run check:catalog && npm run check:content && next build && npm run check:output",
    "start": "next start",
    "lint": "tsc --noEmit"
  },
  "dependencies": { "next": "16.3.3", "react": "19.2.0", "react-dom": "19.2.0" },
  "devDependencies": { "@types/node": "^22.0.0", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "typescript": "^5.7.0" }
}
